<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lost &amp; Found"
            android:textColor="#3048B8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="사용자 선택"
            android:textColor="#1F2937"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="사용자를 선택하거나 새 닉네임을 만들어 시작하세요."
            android:textColor="#606978"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="#DDE1EA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새 사용자 만들기"
                    android:textColor="#1F2937"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사용할 닉네임을 입력해주세요."
                    android:textColor="#606978"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="닉네임"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#6677C8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editNickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateUser"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="새 사용자 생성"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="14dp"
                    app:backgroundTint="@color/button_primary_background"
                    app:rippleColor="#8195E6"
                    app:cornerRadius="16dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="또는"
            android:textColor="#8A909C"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="#DDE1EA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기존 사용자"
                    android:textColor="#1F2937"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이 기기에 저장된 사용자를 선택하세요."
                    android:textColor="#606978"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <Spinner
                    android:id="@+id/spinnerUsers"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="#F2F4FA"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnterUser"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="선택한 사용자로 시작"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#25345F"
                    android:layout_marginTop="14dp"
                    app:backgroundTint="@color/button_secondary_background"
                    app:rippleColor="#7D92DF"
                    app:strokeColor="#A7B6E9"
                    app:strokeWidth="1dp"
                    app:cornerRadius="16dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="※ 사용자 정보는 현재 기기에만 저장됩니다."
            android:textColor="#8A909C"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>